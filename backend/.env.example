NODE_ENV=development
PORT=5000
API_PREFIX=/api

CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/ticketing_system

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

LOG_LEVEL=info

INBOUND_EMAIL_ENABLED=false
INBOUND_EMAIL_WEBHOOK_SECRET=

SWAGGER_ENABLED=true